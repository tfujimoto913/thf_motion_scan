{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thf-motion-scan.dev/schema/thresholds_v2.schema.json",
  "title": "THF Motion Scan Thresholds Definition v2",
  "description": "Threshold configuration used to evaluate reps with VALID/WARN/INVALID states.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "created_at",
    "created_by",
    "description",
    "rules"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "description": "Identifier of the author who published this threshold version."
    },
    "description": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_name",
          "angle_min",
          "angle_max",
          "stability_min",
          "warn_threshold",
          "invalid_threshold"
        ],
        "properties": {
          "test_name": {
            "type": "string",
            "enum": [
              "single_leg_squat",
              "skater_lunge",
              "stride_mimic",
              "upper_body_swing",
              "push_pull",
              "jump_landing",
              "cross_step"
            ]
          },
          "angle_min": {
            "type": "number"
          },
          "angle_max": {
            "type": "number"
          },
          "stability_min": {
            "type": "number"
          },
          "warn_threshold": {
            "type": "number",
            "description": "Delta at which validation state transitions to WARN."
          },
          "invalid_threshold": {
            "type": "number",
            "description": "Delta at which validation state transitions to INVALID."
          }
        }
      }
    }
  }
}
