{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://thf-motion-scan.example.com/schema/thresholds_v2.schema.json",
  "title": "THF Motion Scan Thresholds v2",
  "description": "Validation thresholds schema for THF Motion Scan evaluation system v2",
  "type": "object",
  "required": ["versions", "tests"],
  "additionalProperties": false,
  "properties": {
    "versions": {
      "type": "object",
      "required": ["rules_version", "thresholds_version", "normalization_version", "artifact_sha"],
      "additionalProperties": false,
      "properties": {
        "rules_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "SemVer format: evaluation rules version"
        },
        "thresholds_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "SemVer format: thresholds schema version"
        },
        "normalization_version": {
          "type": "string",
          "description": "Normalization algorithm version (e.g., 'none', '1.0.0')"
        },
        "artifact_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{7,40}$",
          "description": "Git commit SHA (short or full) for build traceability"
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "metric", "unit", "primary"],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^T\\d{2}_B\\d{1,2}$",
            "description": "Test code (e.g., T02_B2 for Test 2, Principle B2)"
          },
          "metric": {
            "type": "string",
            "description": "Metric identifier (e.g., bos_mediolateral_excursion_norm)"
          },
          "unit": {
            "type": "string",
            "enum": ["norm", "deg", "ratio", "count", "bool"],
            "description": "Measurement unit type"
          },
          "primary": {
            "type": "object",
            "required": ["bands"],
            "additionalProperties": false,
            "properties": {
              "bands": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["name", "op", "value"],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "enum": ["pass", "border", "fail"],
                      "description": "Validation band classification"
                    },
                    "op": {
                      "type": "string",
                      "enum": ["lt", "lte", "gt", "gte", "eq", "range_inc", "range_exc"],
                      "description": "Comparison operator"
                    },
                    "value": {
                      "oneOf": [
                        {"type": "number"},
                        {"type": "boolean"},
                        {
                          "type": "array",
                          "minItems": 2,
                          "maxItems": 2,
                          "items": {"type": "number"}
                        }
                      ],
                      "description": "Threshold value (number, boolean, or [min, max] for range)"
                    }
                  }
                }
              }
            }
          },
          "secondary": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "bands": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "op", "value"],
                  "additionalProperties": false,
                  "properties": {
                    "name": {"type": "string", "enum": ["pass", "border", "fail"]},
                    "op": {"type": "string", "enum": ["lt", "lte", "gt", "gte", "eq", "range_inc", "range_exc"]},
                    "value": {
                      "oneOf": [
                        {"type": "number"},
                        {"type": "boolean"},
                        {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
