{
  "$id": "https://thf-motion-scan.dev/schema/session_result/draft-01",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Session Result (Draft 01)",
  "description": "Schema for per-session aggregates that summarize repetitions and their validation.",
  "type": "object",
  "required": ["qc_pass_count", "total_reps", "aggregates", "versions", "validation"],
  "additionalProperties": true,
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier for the athlete session (e.g. 20251031-1518-X)."
    },
    "athlete_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier of the athlete or performer."
    },
    "test_code": {
      "type": "string",
      "pattern": "^T\\d{2}(?:_[A-Za-z0-9]+)+$",
      "description": "Short code for the evaluated test (e.g., T01_single_leg_squat)."
    },
    "qc_pass_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of repetitions that passed QC heuristics."
    },
    "total_reps": {
      "type": "integer",
      "minimum": 0,
      "description": "Total repetitions processed for the session."
    },
    "aggregates": {
      "type": "object",
      "minProperties": 1,
      "description": "Aggregate metrics calculated across repetitions (e.g. best/avg scores).",
      "additionalProperties": {
        "anyOf": [
          {"type": "number"},
          {"type": "string"},
          {"type": "boolean"},
          {"type": "null"},
          {
            "type": "object",
            "additionalProperties": {
              "type": ["number", "string", "boolean", "null"]
            }
          },
          {"type": "array"}
        ]
      }
    },
    "versions": {
      "type": "object",
      "description": "Version metadata for compatibility checks.",
      "required": ["rules_version", "thresholds_version", "artifact_sha"],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "properties": {
        "rules_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "SemVer of the rules package that produced the aggregates."
        },
        "thresholds_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "SemVer of the thresholds package that produced validation limits."
        },
        "normalization_version": {
          "description": "Normalization pipeline version or 'none' when disabled.",
          "oneOf": [
            {"type": "string", "enum": ["none"]},
            {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"}
          ]
        },
        "artifact_sha": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{7,40}|local-dev)$",
          "description": "Git commit sha for traceability (short or full)."
        }
      }
    },
    "validation": {
      "type": "object",
      "description": "Outcome of validation_engine checks for the session aggregates.",
      "required": ["state", "violations"],
      "additionalProperties": true,
      "properties": {
        "state": {
          "type": "string",
          "enum": ["OK", "WARN", "ERROR"],
          "description": "Overall compatibility status (ValidationEngine aggregate)."
        },
        "violations": {
          "type": "array",
          "description": "List of validation issues that prevented an OK state.",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "severity": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
