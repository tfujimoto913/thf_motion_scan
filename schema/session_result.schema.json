{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thf-motion-scan.dev/schema/session_result.schema.json",
  "title": "THF Motion Scan Session Result",
  "description": "Session-level aggregate across five repetitions with validation state and QC gate outcome.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "athlete_id",
    "test_name",
    "threshold_version",
    "aggregated_scores",
    "validation",
    "metadata"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9\\-]{6,64}$"
    },
    "athlete_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9\\-]{3,64}$"
    },
    "test_name": {
      "type": "string",
      "enum": [
        "single_leg_squat",
        "skater_lunge",
        "stride_mimic",
        "upper_body_swing",
        "push_pull",
        "jump_landing",
        "cross_step"
      ]
    },
    "threshold_version": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+$"
    },
    "aggregated_scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mean_composite",
        "std_composite",
        "valid_rep_count",
        "total_rep_count"
      ],
      "properties": {
        "mean_composite": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "std_composite": {
          "type": "number",
          "minimum": 0
        },
        "valid_rep_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "total_rep_count": {
          "type": "integer",
          "enum": [5]
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "messages",
        "qc_gate_result"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "VALID",
            "WARN",
            "INVALID"
          ]
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "qc_gate_result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gate_name",
            "passed",
            "criteria_met"
          ],
          "properties": {
            "gate_name": {
              "type": "string",
              "enum": ["B4_sigma"]
            },
            "passed": {
              "type": "boolean"
            },
            "criteria_met": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "reps": {
      "type": "array",
      "description": "Overall validation state per repetition.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rep_id",
          "state"
        ],
        "properties": {
          "rep_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9\\-]{6,64}$"
          },
          "state": {
            "type": "string",
            "enum": [
              "VALID",
              "WARN",
              "INVALID"
            ]
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processed_at",
        "versions"
      ],
      "properties": {
        "processed_at": {
          "type": "string",
          "format": "date-time"
        },
        "versions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "threshold",
            "schema"
          ],
          "properties": {
            "threshold": {
              "type": "string",
              "pattern": "^v\\d+\\.\\d+$"
            },
            "schema": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            }
          }
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
