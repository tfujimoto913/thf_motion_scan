    "_comment": "8原則（B1-B8）定義",
    "B1": {
      "name": "B1: 体幹安定性 (Core Stability)",
      "description": "体幹の安定性、胴体の揺れ抑制",
      "evaluation_method": "体幹回旋角度、左右肩・腰の高低差、体幹前後傾斜角度",
      "weight": "primary_or_secondary"
    },
    "B2": {
      "name": "B2: 支持基盤 (Support Foundation)",
      "description": "支持脚の安定性、支持基盤の確保",
      "evaluation_method": "支持脚膝の内外反、足部の接地状態、重心バランス",
      "weight": "primary_or_secondary"
    },
    "B3": {
      "name": "B3: 3関節連動性 (3-Joint Coordination)",
      "description": "股関節・膝関節・足関節の協調動作",
      "evaluation_method": "股・膝・足関節の角度変化パターン、タイミング同期性",
      "weight": "primary_or_secondary"
    },
    "B4": {
      "name": "B4: 骨盤水平維持 (Pelvis Horizontal)",
      "description": "骨盤の水平保持、左右の高低差抑制",
      "evaluation_method": "左右腰の高低差、骨盤傾斜角度",
      "weight": "primary_or_secondary"
    },
    "B5": {
      "name": "B5: 重心移動 (Weight Shift)",
      "description": "重心の適切な移動制御",
      "evaluation_method": "重心位置の軌跡、移動速度、方向性",
      "weight": "primary_or_secondary"
    },
    "B6": {
      "name": "B6: 後方筋群活性化 (Posterior Chain)",
      "description": "後方筋群（ハムストリング、臀部）の活性化",
      "evaluation_method": "股関節伸展角度、膝関節と股関節の協調パターン",
      "weight": "primary_or_secondary"
    },
    "B7": {
      "name": "B7: 上下身分離性 (Upper-Lower Separation)",
      "description": "上半身と下半身の独立動作、分離性",
      "evaluation_method": "体幹回旋と骨盤回旋の差、上半身の安定性",
      "weight": "primary_or_secondary"
    },
    "B8": {
      "name": "B8: 肩周り独立制御 (Shoulder Independent Control)",
      "description": "肩甲骨・肩関節の独立制御、上肢の安定性",
      "evaluation_method": "肩甲骨の安定性、肩の高低差、上腕の動作パターン",
      "weight": "primary_or_secondary"
    }
  },

